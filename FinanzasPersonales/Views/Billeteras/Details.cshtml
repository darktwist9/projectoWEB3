@model Billetera
@{
    ViewData["Title"] = $"Billetera {Model.Nombre}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Nombre</h1>
        <span class="text-muted">@Model.Tipo.ObtenerNombre() de @Model.Usuario!.Nombre</span>
    </div>
    <div>
        <a asp-controller="Transacciones" asp-action="Create" asp-route-billeteraId="@Model.Id" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Registrar transacción</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card tarjeta-resumen"><div class="card-body">
            <div class="text-muted">Saldo inicial</div>
            <div class="valor">@Model.SaldoInicial.ToMoneda()</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card tarjeta-resumen"><div class="card-body">
            <div class="text-muted">Movimientos</div>
            <div class="valor">@Model.Transacciones.Count</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card tarjeta-resumen"><div class="card-body">
            <div class="text-muted">Saldo actual</div>
            <div class="valor @(Model.SaldoActual < 0 ? "text-danger" : "text-primary")">@Model.SaldoActual.ToMoneda()</div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header"><strong>Transacciones de esta billetera</strong></div>
    @if (Model.Transacciones.Count == 0)
    {
        <div class="card-body text-muted">Esta billetera todavía no tiene transacciones.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 tabla-numeros">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th>Persona</th>
                        <th class="numero">Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaccion in Model.Transacciones.OrderByDescending(t => t.Fecha))
                    {
                        <tr>
                            <td>@transaccion.Fecha.ToFecha()</td>
                            <td>@transaccion.Descripcion</td>
                            <td>@transaccion.Categoria!.Nombre</td>
                            <td>@(transaccion.Persona?.Nombre ?? "—")</td>
                            <td class="numero @(transaccion.MontoConSigno < 0 ? "text-danger" : "text-success")">@transaccion.MontoConSigno.ToMoneda()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
