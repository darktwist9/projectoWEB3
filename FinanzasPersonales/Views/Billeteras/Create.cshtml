@model BilleteraFormViewModel
@{
    ViewData["Title"] = "Nueva billetera";
}

<h1 class="h3 mb-3">Nueva billetera</h1>
<div class="card col-lg-6">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_Formulario" model="Model" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar billetera</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
