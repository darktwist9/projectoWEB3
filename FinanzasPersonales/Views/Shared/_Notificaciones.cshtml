@* Mensajes de confirmación o error enviados por los controladores (ver Helpers/Notificaciones.cs) *@
@if (TempData[Notificaciones.ClaveExito] is string exito)
{
    <div class="alert alert-success alert-dismissible fade show no-imprimir" role="alert">
        <i class="bi bi-check-circle-fill"></i> @exito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData[Notificaciones.ClaveError] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show no-imprimir" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
