@model List<Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Nuevo usuario</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay usuarios registrados. Use el botón "Nuevo usuario" para agregar el primero.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo electrónico</th>
                        <th>Fecha de registro</th>
                        <th>Billeteras</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.FechaRegistro.ToFecha()</td>
                            <td>
                                <a asp-controller="Billeteras" asp-action="Index" asp-route-usuarioId="@usuario.Id">
                                    @usuario.Billeteras.Count billetera(s)
                                </a>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Billeteras" asp-action="Create" asp-route-usuarioId="@usuario.Id" class="btn btn-sm btn-outline-success" title="Agregar billetera">
                                    <i class="bi bi-wallet2"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
