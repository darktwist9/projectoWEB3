@model PrestamoDeuda
@{
    ViewData["Title"] = Model.Resumen;
    var textoPago = Model.Tipo == TipoPrestamo.PrestamoOtorgado ? "Registrar cobro" : "Registrar pago";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0">@Model.Resumen <partial name="_EstadoPrestamo" model="Model.Estado" /></h1>
        <span class="text-muted">@Model.Tipo.ObtenerNombre() · @(Model.Descripcion ?? "Sin descripción")</span>
    </div>
    <div>
        @if (Model.Transacciones.Count == 0)
        {
            <a asp-controller="Transacciones" asp-action="Create" asp-route-prestamoDeudaId="@Model.Id" class="btn btn-primary">
                <i class="bi bi-cash"></i> Registrar desembolso
            </a>
        }
        else if (Model.Estado != EstadoPrestamo.Saldado)
        {
            <a asp-controller="Transacciones" asp-action="Create" asp-route-prestamoDeudaId="@Model.Id" class="btn btn-success">
                <i class="bi bi-cash-coin"></i> @textoPago
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card tarjeta-resumen"><div class="card-body">
            <div class="text-muted">Monto</div>
            <div class="valor">@Model.Monto.ToMoneda()</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card tarjeta-resumen"><div class="card-body">
            <div class="text-muted">Pagado</div>
            <div class="valor text-success">@Model.MontoPagado.ToMoneda()</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card tarjeta-resumen"><div class="card-body">
            <div class="text-muted">Saldo pendiente</div>
            <div class="valor text-danger">@Model.SaldoPendiente.ToMoneda()</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card tarjeta-resumen"><div class="card-body">
            <div class="text-muted">Inicio / vencimiento</div>
            <div class="fw-semibold">@Model.FechaInicio.ToFecha() — @Model.FechaVencimiento.ToFecha()</div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header"><strong>Transacciones vinculadas</strong></div>
    @if (Model.Transacciones.Count == 0)
    {
        <div class="card-body text-muted">
            Aún no se registró el desembolso. Use el botón "Registrar desembolso" para crear la transacción correspondiente.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 tabla-numeros">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Billetera</th>
                        <th>Concepto</th>
                        <th class="numero">Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaccion in Model.Transacciones.OrderBy(t => t.Fecha))
                    {
                        var esPago = transaccion.Categoria!.Tipo == Model.TipoDePago;
                        <tr>
                            <td>@transaccion.Fecha.ToFecha()</td>
                            <td>@transaccion.Descripcion</td>
                            <td>@transaccion.Billetera!.Nombre</td>
                            <td><span class="badge @(esPago ? "text-bg-success" : "text-bg-secondary")">@(esPago ? "Pago" : "Desembolso")</span></td>
                            <td class="numero @(transaccion.MontoConSigno < 0 ? "text-danger" : "text-success")">@transaccion.MontoConSigno.ToMoneda()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
