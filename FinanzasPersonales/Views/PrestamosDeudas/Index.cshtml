@model List<PrestamoDeuda>
@{
    ViewData["Title"] = "Préstamos y deudas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Préstamos y deudas</h1>
    <div>
        <a asp-controller="Reportes" asp-action="PrestamosPendientes" class="btn btn-outline-primary"><i class="bi bi-bar-chart-line"></i> Reporte de pendientes</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo préstamo / deuda</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay préstamos ni deudas registrados.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 tabla-numeros">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Persona</th>
                        <th>Inicio</th>
                        <th>Vencimiento</th>
                        <th class="numero">Monto</th>
                        <th class="numero">Pagado</th>
                        <th class="numero">Saldo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prestamo in Model)
                    {
                        <tr>
                            <td>@prestamo.Tipo.ObtenerNombre()</td>
                            <td>@prestamo.Persona!.Nombre</td>
                            <td>@prestamo.FechaInicio.ToFecha()</td>
                            <td>@prestamo.FechaVencimiento.ToFecha()</td>
                            <td class="numero">@prestamo.Monto.ToMoneda()</td>
                            <td class="numero">@prestamo.MontoPagado.ToMoneda()</td>
                            <td class="numero fw-semibold">@prestamo.SaldoPendiente.ToMoneda()</td>
                            <td><partial name="_EstadoPrestamo" model="prestamo.Estado" /></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@prestamo.Id" class="btn btn-sm btn-outline-secondary" title="Ver detalle y pagos"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@prestamo.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@prestamo.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
