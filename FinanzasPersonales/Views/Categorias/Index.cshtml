@model List<Categoria>
@{
    ViewData["Title"] = "Categorías";
    var tipoSeleccionado = ViewData["TipoSeleccionado"] as TipoCategoria?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categorías</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva categoría</a>
</div>

<div class="btn-group mb-3" role="group" aria-label="Filtrar por tipo">
    <a asp-action="Index" class="btn btn-outline-secondary @(tipoSeleccionado == null ? "active" : "")">Todas</a>
    @foreach (var tipo in Enum.GetValues<TipoCategoria>())
    {
        <a asp-action="Index" asp-route-tipo="@tipo" class="btn btn-outline-secondary @(tipoSeleccionado == tipo ? "active" : "")">@tipo.ObtenerNombre()</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay categorías para mostrar.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Transacciones</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td>@categoria.Nombre</td>
                            <td>
                                <span class="badge @(categoria.Tipo == TipoCategoria.Ingreso ? "text-bg-success" : "text-bg-danger")">@categoria.Tipo.ObtenerNombre()</span>
                            </td>
                            <td>@categoria.Descripcion</td>
                            <td>
                                <a asp-controller="Transacciones" asp-action="Index" asp-route-categoriaId="@categoria.Id">@categoria.Transacciones.Count</a>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
