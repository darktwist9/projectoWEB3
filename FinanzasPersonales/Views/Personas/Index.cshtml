@model List<Persona>
@{
    ViewData["Title"] = "Personas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Personas</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Nueva persona</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por nombre..." aria-label="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No se encontraron personas.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Correo electrónico</th>
                        <th>Transacciones</th>
                        <th>Préstamos / deudas</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var persona in Model)
                    {
                        <tr>
                            <td>@persona.Nombre</td>
                            <td>@(persona.Telefono ?? "—")</td>
                            <td>@(persona.Email ?? "—")</td>
                            <td>@persona.Transacciones.Count</td>
                            <td>
                                <a asp-controller="Reportes" asp-action="PrestamosPendientes" asp-route-personaId="@persona.Id">@persona.PrestamosDeudas.Count</a>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="PrestamosDeudas" asp-action="Create" asp-route-personaId="@persona.Id" class="btn btn-sm btn-outline-success" title="Registrar préstamo o deuda">
                                    <i class="bi bi-cash-coin"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@persona.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@persona.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
